# Copy this file to .env and fill in your own values. Never commit .env.
# Featherless.ai API key (https://featherless.ai) used by src/llm_adapter.py's
# FeatherlessExplanationProvider for the bounded AI explanation capability.
FEATHERLESS_API_KEY=

# Optional: override the model (defaults to mistralai/Mistral-Nemo-Instruct-2407 in code).
FEATHERLESS_MODEL=

# Reviewer API (src/access/). docker compose reads this file; the Python scripts read the process environment, so export these
# in your shell (or your process manager) as well. Secrets must each be at least 32 characters and different from one another; generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# FERNET_KEY is generated with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=
FERNET_KEY=
AUDIT_ANCHOR_KEY=
PII_KEY=
# MongoDB (docker compose up -d mongo). MONGO_URI is what the server and the tests read.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_URI=
