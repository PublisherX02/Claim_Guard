# For a real domain name that points at this machine (ports 80 and 443 reachable): Caddy gets and renews a Let's Encrypt certificate.
# Slow or oversized requests are cut off at the proxy, before they reach the application (slowloris, giant headers).
{
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
		max_header_size 16KB
	}
}

{$CG_SITE} {
	# live updates (server-sent events): never compressed (a compressor can hold small messages back) and flushed at once
	@events path /api/v1/work/events
	handle @events {
		reverse_proxy api:8443 {
			flush_interval -1
		}
	}
	# importing files: a scanned page or a FHIR export is larger than any other request, so these two paths (and only these) may carry up to 17 MB;
	# the application checks the real size and kind of what arrives (docs/45)
	@upload path /api/v1/queue/import/file /api/v1/queue/import/csv
	handle @upload {
		request_body {
			max_size 17MB
		}
		reverse_proxy api:8443
	}
	handle {
		encode zstd gzip
		# no request the application accepts is larger than this; refuse anything bigger here, with a clean 413, before it is forwarded
		request_body {
			max_size 100KB
		}
		reverse_proxy api:8443
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
