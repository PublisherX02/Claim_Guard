# For a real domain name that points at this machine (ports 80 and 443 reachable): Caddy gets and renews a Let's Encrypt certificate.
# Slow or oversized requests are cut off at the proxy, before they reach the application (slowloris, giant headers).
{
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
		max_header_size 16KB
	}
}

{$CG_SITE} {
	encode zstd gzip
	# no request the application accepts is larger than this; refuse anything bigger here, with a clean 413, before it is forwarded
	request_body {
		max_size 100KB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
	reverse_proxy api:8443
}
