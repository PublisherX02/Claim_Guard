# Copy to ../.env on the server (deploy/install.sh does this and fills the secrets for you). Never commit the real file.
# The address people type: a domain name (use CADDYFILE=Caddyfile.public) or this machine's IP address (Caddyfile.internal).
CG_SITE=claims.example.org
CADDYFILE=Caddyfile.internal

# Secrets. Each at least 32 characters and different from one another. install.sh generates them.
JWT_SECRET=
AUDIT_ANCHOR_KEY=
PII_KEY=
FERNET_KEY=
DATA_KEY=
# After `cg rotate-key`: the old DATA_KEY (or the FERNET_KEY, if DATA_KEY was empty), so audit-log rows written under it stay readable. Comma separated.
DATA_KEY_PREVIOUS=
# Two-person approval of dangerous administrator actions (true is the default; applies once two administrators exist).
DUAL_CONTROL=true

# Signed ledger over the audit logs (docs/45). The SEED signs checkpoints and goes to the worker only; the PUBLIC key goes to the API and to your records
# (copy it somewhere offline). install.sh makes both. `cg ledger keygen` makes a new pair. Leave both empty to switch the ledger off.
LEDGER_SIGNING_KEY=
LEDGER_PUBLIC_KEY=
#LEDGER_CHECKPOINT_SECONDS=300

# "Ask the rulebook" by meaning, not only by keywords (docs/52): start the stack with --profile search and set these. Without them (or when the service is down)
# the keyword search answers and the console says so. The threshold 0.485 belongs to the default model (bge-m3, docs/55); another model needs its own (re-run rust/tools/rag_parity.py).
#EMBEDDER_URL=http://embed:8091
#EMBEDDER_TOKEN=                  # a long random secret, shared by the API and the embedding service
#EMBEDDER_THRESHOLD=0.485

# Importing claims from PDFs and pictures (docs/45): start the stack with --profile documents (install.sh ... docs does it) and set these.
#DOCUMENT_READER_URL=http://reader:8090
#DOCUMENT_READER_TOKEN=
#DOCUMENT_READER_ENGINE=auto      # auto = both readers when a vision model is configured, else Tesseract; tesseract | vlm | both
#DOCUMENT_READER_LANGS=eng        # eng+ara for Arabic as well
#VLM_BASE_URL=http://vllm-vision:8000/v1   # a vision model served by its own vLLM (one model per server): set VLLM_VLM_MODEL below and use --profile vision
#VLM_MODEL=                                # the same Hugging Face repository id as VLLM_VLM_MODEL
#VLLM_VLM_MODEL=
#VLLM_VLM_GPU_UTIL=0.30                    # share of the card's memory; this plus VLLM_GPU_UTIL must stay under 0.95 (install.sh refuses more)

# MongoDB root account (private network only).
MONGO_ROOT_USER=claimguard
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=

# Claims processed at the same moment by the worker, and so the most the AI model is asked at once (1 to 64). Keep it at or below the number of
# parallel requests the model server can really run (an RTX 3080 with a 4B model, measured on the server: 356 explanations a minute at 4, 368 at 8, flat after that, docs/66). The vLLM server is given the same number (--max-num-seqs).
#CG_WORKER_CONCURRENCY=4

# MongoDB's cache in GB (default 1). On a 12 GB server 1 to 2 is plenty; raise it only on a bigger machine or a very large claim history.
#MONGO_CACHE_GB=1

# Optional: let a language model draft the plain-English explanation of each flagged finding (it never sees claim values and never sets a status).
# vllm = a model on this machine, served by vLLM (an OpenAI-compatible server). Download the weights once, then start the stack with --profile ai:
#   HF_TOKEN=hf_... docker compose -f deploy/rust/compose.yml --env-file .env --profile ai-fetch run --rm vllm-fetch     (install.sh ... ai does both)
#QUEUE_AI_PROVIDER=vllm
#VLLM_MODEL=google/gemma-3-4b-it      # a Hugging Face repository id; Gemma is gated (accept the licence, give HF_TOKEN to the download only)
#VLLM_API_KEY=                        # a long random secret: the server refuses requests without it (install.sh generates one)
#VLLM_GPU_UTIL=0.85                   # share of the card's memory the explanation model may take (0.85 worked on an RTX 3080 10 GB; 0.55 did not: no memory for the KV cache)
#VLLM_MAX_LEN=2048                    # longest prompt plus answer in tokens (8192 if ASK_LLM_PREFIX=1: the rulebook prefix is about 3,600 tokens)
#
# "Ask the rulebook" (docs/60). The graph, the cache and passage search need nothing here. A model is optional: it only picks one of 11 fixed graph
# queries and writes the cited facts up, and its text is shown only if every sentence cites a fact and every id and number is in the facts.
#ASK_LLM_PROVIDER=vllm                # uses VLLM_BASE_URL, VLLM_MODEL and VLLM_API_KEY above; empty = no model
#ASK_LLM_PREFIX=                      # 1 = the whole rulebook first in every prompt (needs VLLM_MAX_LEN=8192; the saving needs vLLM's prefix caching, not yet measured on the server)
#ASK_LLM_TIMEOUT=60                   # seconds one model call may take
#ASK_PER_MINUTE=30                    # questions per person per minute
#ASK_GENERATE_PER_MINUTE=6            # of those, written answers (each holds the model for several seconds)
#
# Privacy (docs/58, docs/59)
#CG_PATIENT_KEYS=true                 # a key per patient: erasing a person destroys it, so older backups cannot be read for them (replay the ledger after a restore: cg replay-erasures)
#RETENTION_DAYS=0                     # days a decided claim is kept before the worker erases it; 0 keeps everything (the insurer decides)
#VLLM_EXTRA_ARGS=--quantization fp8   # weight-only FP8 so the 4B model fits an RTX 3080 (10 GB); a space for a card with room
#VLLM_IMAGE=vllm/vllm-openai:v0.31.0-cu129@sha256:ff29e51a9457f191deb332b96fa6440584fa941aa2a548449b604e2b1e5e1eeb  # pinned (the CUDA 12.9 build); check the driver with nvidia-smi first (docs/40 section 12)
#QUEUE_AI_TWO_PASS=

# ---- Settings that rarely need changing (the compose defaults are right for most installs) ----
# Audit protection (docs/39): an optional RFC 3161 timestamp authority. Empty: the health panel shows the 'timestamp' check as "unknown", which is expected.
#TSA_URL=
#TSA_CA_FILE=
#AUDIT_MIRROR_DIR=/mirror
# Hours a second administrator has to approve a dangerous action (seconds), and how long a queue message may sit idle before another consumer takes it over (empty: the explanation ceiling plus 30 s).
#APPROVAL_TTL_SECONDS=86400
#CG_BROKER_MIN_IDLE_SECONDS=
# Longest written answer of "Ask the rulebook" in tokens, and how long the embedding service may take for a batch (seconds).
#ASK_LLM_MAX_TOKENS=400
#EMBEDDER_TIMEOUT=60
# Where the API finds the explanation model (the default is the vllm container) and an optional commit hash that pins its weights at download.
#VLLM_BASE_URL=http://vllm:8000
#VLLM_MODEL_REVISION=
# The vision model for documents (docs/45, docs/47): its Hugging Face repository (CG_VLM_MODEL in install.sh sets VLLM_VLM_MODEL and VLM_MODEL), its longest prompt
# and extra vLLM arguments. Pin the weights at download with CG_FETCH_MODELS="google/gemma-3-4b-it baidu/Unlimited-OCR@<commit hash>". vLLM support for this
# particular model is not yet verified on the server; on a 10 GB card it does not fit next to the explanation model (VLLM_GPU_UTIL + VLLM_VLM_GPU_UTIL must stay under 0.95).
#VLLM_VLM_MAX_LEN=4096
#VLLM_VLM_EXTRA_ARGS=
#CG_FETCH_MODELS=google/gemma-3-4b-it
# Passed through by compose but NOT read by the Rust build (left over from the Python build); setting them changes nothing. The API takes the client address from the last
# X-Forwarded-For entry that the proxy appends (--behind-proxy); behind Cloudflare that is a Cloudflare address unless the proxy is told to trust it (docs/47, 'Behind Cloudflare').
#TRUSTED_PROXY_IPS=*
#FEATHERLESS_API_KEY=
