# Copy to ../.env on the server (deploy/install.sh does this and fills the secrets for you). Never commit the real file.
# The address people type: a domain name (use CADDYFILE=Caddyfile.public) or this machine's IP address (Caddyfile.internal).
CG_SITE=claims.example.org
CADDYFILE=Caddyfile.internal

# Secrets. Each at least 32 characters and different from one another. install.sh generates them.
JWT_SECRET=
AUDIT_ANCHOR_KEY=
PII_KEY=
FERNET_KEY=
DATA_KEY=
# After `cg rotate-key`: the old DATA_KEY (or the FERNET_KEY, if DATA_KEY was empty), so audit-log rows written under it stay readable. Comma separated.
DATA_KEY_PREVIOUS=
# Two-person approval of dangerous administrator actions (true is the default; applies once two administrators exist).
DUAL_CONTROL=true

# Signed ledger over the audit logs (docs/45). The SEED signs checkpoints and goes to the worker only; the PUBLIC key goes to the API and to your records
# (copy it somewhere offline). install.sh makes both. `cg ledger keygen` makes a new pair. Leave both empty to switch the ledger off.
LEDGER_SIGNING_KEY=
LEDGER_PUBLIC_KEY=
#LEDGER_CHECKPOINT_SECONDS=300

# Importing claims from PDFs and pictures (docs/45): start the stack with --profile documents (install.sh ... docs does it) and set these.
#DOCUMENT_READER_URL=http://reader:8090
#DOCUMENT_READER_TOKEN=
#DOCUMENT_READER_ENGINE=auto      # auto = both readers when a vision model is configured, else Tesseract; tesseract | vlm | both
#DOCUMENT_READER_LANGS=eng        # eng+ara for Arabic as well
#VLM_BASE_URL=http://vllm-vision:8000/v1   # a vision model served by its own vLLM (one model per server): set VLLM_VLM_MODEL below and use --profile vision
#VLM_MODEL=                                # the same Hugging Face repository id as VLLM_VLM_MODEL
#VLLM_VLM_MODEL=
#VLLM_VLM_GPU_UTIL=0.30                    # share of the card's memory; this plus VLLM_GPU_UTIL must stay below 1

# MongoDB root account (private network only).
MONGO_ROOT_USER=claimguard
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=

# Claims processed at the same moment by the worker, and so the most the AI model is asked at once (1 to 64). Keep it at or below the number of
# parallel requests the model server can really run (an RTX 3080 with a 4B model: about 8, UNMEASURED). The vLLM server is given the same number (--max-num-seqs).
#CG_WORKER_CONCURRENCY=4

# MongoDB's cache in GB (default 1). On a 12 GB server 1 to 2 is plenty; raise it only on a bigger machine or a very large claim history.
#MONGO_CACHE_GB=1

# Optional: let a language model draft the plain-English explanation of each flagged finding (it never sees claim values and never sets a status).
# vllm = a model on this machine, served by vLLM (an OpenAI-compatible server). Download the weights once, then start the stack with --profile ai:
#   HF_TOKEN=hf_... docker compose -f deploy/rust/compose.yml --env-file .env --profile ai-fetch run --rm vllm-fetch     (install.sh ... ai does both)
#QUEUE_AI_PROVIDER=vllm
#VLLM_MODEL=google/gemma-3-4b-it      # a Hugging Face repository id; Gemma is gated (accept the licence, give HF_TOKEN to the download only)
#VLLM_API_KEY=                        # a long random secret: the server refuses requests without it (install.sh generates one)
#VLLM_GPU_UTIL=0.55                   # share of the card's memory the explanation model may take
#VLLM_MAX_LEN=2048                    # longest prompt plus answer in tokens
#VLLM_EXTRA_ARGS=--quantization fp8   # weight-only FP8 so the 4B model fits an RTX 3080 (10 GB); a space for a card with room
#VLLM_IMAGE=vllm/vllm-openai:v0.31.0-cu129@sha256:ff29e51a9457f191deb332b96fa6440584fa941aa2a548449b604e2b1e5e1eeb  # pinned (the CUDA 12.9 build); check the driver with nvidia-smi first (docs/40 section 12)
#QUEUE_AI_TWO_PASS=
