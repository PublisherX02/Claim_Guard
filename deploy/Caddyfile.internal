# For a machine reached by IP address or an internal name: Caddy issues a certificate from its own private authority.
# Browsers show a warning until you trust that authority (docs/35 says how); the desktop app can be pointed at it the same way.
# Slow or oversized requests are cut off at the proxy, before they reach the application (slowloris, giant headers).
{
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
		max_header_size 16KB
	}
}

{$CG_SITE} {
	tls internal
	# live updates (server-sent events): never compressed (a compressor can hold small messages back) and flushed at once
	@events path /api/v1/work/events
	handle @events {
		reverse_proxy api:8443 {
			flush_interval -1
		}
	}
	handle {
		encode zstd gzip
		# no request the application accepts is larger than this; refuse anything bigger here, with a clean 413, before it is forwarded
		request_body {
			max_size 100KB
		}
		reverse_proxy api:8443
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
